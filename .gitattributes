* text=auto eol=lf

# Lanzadores de Windows: CRLF para compatibilidad con cmd.exe
*.bat text eol=crlf
*.cmd text eol=crlf

# Código y datos
*.py text
*.js text
*.html text
*.css text
*.sql text
*.md text
*.json text
*.yml text
*.yaml text
*.svg text

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
*.gz binary
*.pdf binary

# Evitar diffs ruidosos en archivos generados
*.min.js linguist-generated=true
*.min.css linguist-generated=true
