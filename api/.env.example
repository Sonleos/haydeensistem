# ---------------------------------------------------------------------------
# Haydeén Sistema · plantilla de configuración
#
# No copies este archivo a mano: scripts/init_db.py crea api/.env
# automáticamente y genera SECRET_KEY la primera vez.
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development

# --- Base de datos ---------------------------------------------------------
# En local con Laragon: root sin contraseña.
# En producción crea un usuario dedicado con permisos mínimos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=haydeensistem
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=10

# --- Sesiones --------------------------------------------------------------
# Horas de vigencia del token Bearer.
SESSION_HOURS=12

# Orígenes permitidos separados por coma. Usa '*' solo en desarrollo local.
# En producción: https://enfermeria.midominio.com
CORS_ORIGINS=*

# Clave para el HMAC de los tokens de sesión en reposo.
# init_db.py genera una automáticamente si está vacía.
# Si cambias esta clave, todas las sesiones activas se invalidan.
SECRET_KEY=

# --- Servidor --------------------------------------------------------------
# 0.0.0.0 permite acceso desde la LAN; 127.0.0.1 solo local.
API_HOST=0.0.0.0
API_PORT=8000

# --- Usuarios iniciales (opcional) -----------------------------------------
# Si no defines estas variables, scripts/init_db.py genera contraseñas
# aleatorias y las muestra una sola vez. Mínimo 12 caracteres.
# SEED_ADMIN_PASSWORD=
# SEED_MEDICO_PASSWORD=
# SEED_ENFERMERO_PASSWORD=
# SEED_ADMINISTRATIVO_PASSWORD=
