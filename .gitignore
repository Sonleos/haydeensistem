# ---------------------------------------------------------------------------
# Haydeén Sistema - .gitignore
# ---------------------------------------------------------------------------

# --- Secretos y configuración local ---------------------------------------
.env
.env.*
!.env.example
*.env
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
secrets/
config.local.*
credentials*
!credentials.example

# --- Entornos virtuales ----------------------------------------------------
.venv/
venv/
env/
ENV/
virtualenv/
.python-version
__pypackages__/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
cython_debug/
profile_default/
ipython_config.py

# --- Empaquetado de escritorio --------------------------------------------
*.spec
!packaging/*.spec
build/
dist/
*.exe
*.msi
*.app
*.dmg
*.pkg
*.zip
*.7z
*.rar
installer/
output/
packaging/build/
packaging/dist/
packaging/output/
*.iss.bak

# --- Node / frontend -------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json.bak
web/dist/
web/.cache/
.vite/
.parcel-cache/
.eslintcache
.stylelintcache

# --- Pruebas E2E -----------------------------------------------------------
test-results/
playwright-report/
playwright/.cache/
blob-report/
.allure/
*.trace.zip
*.har
screenshots/actual/
screenshots/diff/
screenshots/failures/

# --- Seeds exportados (contienen hashes PBKDF2 y datos clínicos) ----------
database/seeds/*.json
!database/seeds/.gitkeep

# --- Base de datos y volcados ---------------------------------------------
*.sql.bak
*.sql.gz
*.sql.zip
*.sql.7z
*.dump
*.bak
*.backup
*.old
*.orig
*.rej
dumps/
backups/
*.ibd
*.frm
*.myd
*.myi
mysql-data/
data/
!database/*.sql
!database/demo_data.sql
!database/schema.sql

# --- Logs y temporales -----------------------------------------------------
*.log
logs/
log/
*.log.*
*.tmp
*.temp
*.swp
*.swo
*~
*.pid
*.seed
*.pid.lock
*.stackdump
core
core.*
crash.log
npm-debug.log*
*.trace

# --- Sesiones y cachés de la aplicación -----------------------------------
api/sesiones*
api/session*
desktop/sesiones*
*.session
*.sess
.cache/
tmp/
temp/
.cookie*
cookies.txt

# --- Editores e IDE --------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json
*.iml
*.ipr
*.iws
*.suo
*.user
*.userosscache
*.sln.docstates
*.code-workspace
.vs/
*.vscode-test/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
nbproject/
*.nbproject/

# --- Sistema operativo -----------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.cab
*.stackdump

# --- Herramientas y reportes ----------------------------------------------
.gitleaks/
trufflehog-report*
*.sarif
dependency-check-report.*
pip-audit-report.*
audit.json
*.hprof
.vercel/
.netlify/

# --- Documentos temporales -------------------------------------------------
*.docx
*.xlsx
*.pptx
~$*
*.pdf.tmp

# --- Excepciones explícitas ------------------------------------------------
!database/schema.sql
!database/demo_data.sql
!api/.env.example
!docs/screenshots/*.svg
!docs/screenshots/*.png
!docs/screenshots/*.webp
